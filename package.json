{
  "name": "departs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint app spacefast vitest.config.ts eslint.config.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:spacefast": "esbuild spacefast/functions/index.ts spacefast/functions/api/departures.ts spacefast/functions/api/directions.ts spacefast/functions/api/stops/nearby.ts --bundle --format=esm --platform=browser --outbase=spacefast --outdir=.spacefast/worker"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "msw": "^2.12.10",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "description": "Native iOS transit app and its Spacefast Functions backend"
}
